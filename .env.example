# Copy this file to `.env` and fill in your real Postgres password.
# `.env` is gitignored so your password is never committed.

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=cve_intel

# Maintenance DB used only to CREATE the target database during migration.
DB_MAINTENANCE=postgres

# Ingestion politeness: seconds to wait between CVEs so we respect the
# public NVD rate limit (~5 requests / rolling 30s without an API key).
NVD_REQUEST_DELAY_SECONDS=6
HTTP_TIMEOUT_SECONDS=20

# Seconds between watchlist passes when running `python -m app.ingestion --loop`.
INGEST_INTERVAL_SECONDS=900
