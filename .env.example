# Copy this file to `.env` and fill in your real Postgres password.
# `.env` is gitignored so your password is never committed.

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=outage_intel

# Maintenance DB used only to CREATE the target database during migration.
DB_MAINTENANCE=postgres

# Freshness: a snapshot older than this is served as stale (catalog: "minutes").
TTL_SECONDS=900
# Raw provider payloads are purged after this age.
RAW_TTL_SECONDS=21600
# Snapshots are summarised into hourly rollups after this age.
SNAPSHOT_TTL_SECONDS=86400
# Seconds between passes when running `python -m app.ingestion --loop`.
INGEST_INTERVAL_SECONDS=300

HTTP_TIMEOUT_SECONDS=25

# Set to 0 to disable the per-client rate limit (100 requests / 60 s).
RATE_LIMIT_ENFORCE=1
